# Langfuse 开发机部署凭证模板——复制为 deploy/langfuse/.env 并替换全部值(勿提交)。
# 生成随机值:openssl rand -hex 32
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
POSTGRES_PASSWORD=
# agent 侧 .env 复用同一对 key(Langfuse 首启自动建 project 并绑定)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# 首启管理员(登录 Langfuse UI 用)
LANGFUSE_INIT_USER_PASSWORD=
