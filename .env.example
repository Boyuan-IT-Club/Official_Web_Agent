# ===== 后端(Official_Web_Backend)=====
BACKEND_BASE_URL=http://localhost:8080
# 专用服务账号(后端侧创建,最小权限)
BACKEND_SERVICE_USERNAME=
BACKEND_SERVICE_PASSWORD=

# ===== 模型 =====
ANTHROPIC_API_KEY=
# 分级路由:轻量任务(意图分类/抽取)与推理任务(评估/合成)
MODEL_LIGHT=claude-haiku-4-5-20251001
MODEL_STRONG=claude-sonnet-5

# ===== Embedding(RAG 知识库 #134,独立配置组,与上面对话模型无关)=====
# OpenAI-compatible 托管中文 embedding(如 Qwen3-Embedding-0.6B / BGE-M3)
EMBED_PROVIDER=openai-compatible
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_DIM=0

# ===== 状态与记忆(ADR-0007:checkpointer 与长期记忆均用 Postgres)=====
POSTGRES_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/official_agent

# ===== 运行时上下文(冷配置:改动需重启)=====
# 会话超阈值触发压缩(checkpoint 内消息的 tiktoken 计数,不含 system/工具)
CONTEXT_COMPRESS_THRESHOLD_TOKENS=24000
# 压缩后保留的近几轮原始消息条数
CONTEXT_RECENT_KEEP_MESSAGES=12

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ===== 仓库调查(GitHub API)=====
# 可选,但强烈建议填:匿名调用限 60 次/时,且 code search 端点必须带 token。
# 缺省时限流会让**可读的仓被判成不可读**,深挖线整体退回简历深挖。
GITHUB_TOKEN=

# ===== 评估流水线(冷配置:改动需重启)=====
# 评估域同时在途的模型调用上限(评分/探索/出题/审题共用);见到模型侧 429 就调小
# EVALUATION_MODEL_CONCURRENCY=8
# 审题:off(默认)| annotate(出题后逐题给意见,只标注不改题;每条有题的证据线多一次
# strong 调用)。打开前先在真实模型上跑 evals/datasets/question_review_probes.yaml
# QBANK_REVIEW_MODE=off
# 题目向量索引(本包跨线查重 + 跨简历通用题,只标注):需要上面的 EMBED_* 与 pgvector。
# 三个门槛是初值,打开前先拿现有题库量过分布
# QBANK_INDEX_ENABLED=false
# QBANK_DUPLICATE_MIN_SIMILARITY=0.9
# QBANK_GENERIC_MIN_SIMILARITY=0.9
# QBANK_GENERIC_MIN_RESUMES=3
# 规划者:off(默认)| plan(给每条仓线定探索档位与侧重;预算数值由代码按档位映射)。
# 打开前先在真实模型上跑 evals/datasets/plan_probes.yaml 的模型段
# QBANK_PLAN_MODE=off
# 一份简历的探索预算总上限(各仓线之和),规划者开没开都生效;缺省 = 5 条仓线全部最高档
# QBANK_EXPLORE_MAX_TOTAL_TURNS=400
# QBANK_EXPLORE_MAX_TOTAL_WALL_SECONDS=1500

# ===== 观测 =====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
